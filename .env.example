# Supabase Auth + PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (single private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional CDN/public hostname. Private model access still uses signed URLs.
R2_PUBLIC_BASE_URL=

# Tripo3D image-to-3D (server-only)
TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPO_MODEL_VERSION=P1-20260311
TRIPO_FACE_LIMIT=10000
# true = bundled demo, false = real provider, blank = auto-detect credentials
USE_MOCK_AI=

# Optional provider-agnostic HTTP fallback
AI_API_KEY=
AI_API_BASE_URL=

# Standalone model processor (run outside Vercel/Cloudflare request handlers)
MODEL_PROCESSOR_ID=
MODEL_PROCESSOR_POLL_MS=5000

# Public application origin used in QR links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy prototype routes retained during migration
MESHY_API_KEY=
MORPH_GENERATIONS_PER_HOUR=1
MORPH_GENERATIONS_PER_DAY=2
# Comma-separated exact emails that bypass generation limits
MORPH_UNLIMITED_EMAILS=
BLOB_READ_WRITE_TOKEN=
